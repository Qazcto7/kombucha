From 1613ee55aae0016d796002e365a8fc0bca1df2b6 Mon Sep 17 00:00:00 2001
From: Kazim <kazim@localhost>
Date: Thu, 27 Aug 2026 18:08:01 +0000
Subject: [PATCH] winewayland: Emulate SetCursorPos warps for visible, confined
 cursors.

Apps that keep the cursor visible while dragging with a button held
(e.g. Roblox Studio's editor viewport camera orbit) don't go through
the relative-motion path, since wayland_pointer_update_constraint()
only enables it while the cursor is hidden. They instead poll
GetCursorPos once per frame and call SetCursorPos to recenter,
expecting the round trip to be effectively instant as it is on native
Win32.

Under Wayland a real warp is an async request to the compositor, so
at uneven or low frame rates real mouse motion keeps accumulating in
the background while the app is still waiting for GetCursorPos to
reflect a warp that hasn't landed yet. This is felt as laggy or
jumpy camera movement that gets worse the slower/more uneven frames
are (vinegarhq/vinegar#750, #766, #714, #851).

Add an opt-in (WINE_WAYLAND_EMULATE_MOUSE_WARP=1) emulation path:
while a pointer confinement is active for the focused window,
SetCursorPos stops asking the compositor to actually warp the
cursor and instead just remembers the requested position;
GetCursorPos reports that remembered position, and real deltas from
the compositor keep it accurate, same as the relative-motion path
does but without requiring the cursor to be hidden. This decouples
cursor sampling from compositor/frame timing entirely. The emulated
position is dropped, falling back to the normal unmodified
behaviour, as soon as the confinement ends or goes without a fresh
SetCursorPos call for a while.

Opt-in and scoped to apps that set the environment variable (e.g.
vinegar only sets it when launching Roblox Studio specifically), so
this does not change behaviour for any other Wine application.
---
 dlls/winewayland.drv/wayland_pointer.c | 181 ++++++++++++++++++++++++-
 dlls/winewayland.drv/waylanddrv.h      |  16 +++
 dlls/winewayland.drv/waylanddrv_main.c |   1 +
 3 files changed, 197 insertions(+), 1 deletion(-)

diff --git a/dlls/winewayland.drv/wayland_pointer.c b/dlls/winewayland.drv/wayland_pointer.c
index 0c190a9..c3551bf 100644
--- a/dlls/winewayland.drv/wayland_pointer.c
+++ b/dlls/winewayland.drv/wayland_pointer.c
@@ -28,10 +28,12 @@
 #undef SW_MAX /* Also defined in winuser.rh */
 #include <math.h>
 #include <stdlib.h>
+#include <string.h>
 
 #define OEMRESOURCE
 
 #include "waylanddrv.h"
+#include "winternl.h"
 #include "wine/server.h"
 #include "wine/debug.h"
 
@@ -42,6 +44,84 @@ WINE_DEFAULT_DEBUG_CHANNEL(cursor);
  * provide a dummy object here to avoid linking errors. */
 void *zwp_tablet_tool_v2_interface = NULL;
 
+static void pointer_handle_motion_internal(wl_fixed_t sx, wl_fixed_t sy);
+static void wayland_motion_delta_to_window(struct wayland_surface *surface,
+                                           double surface_x, double surface_y,
+                                           double *window_x, double *window_y);
+
+/*
+ * SetCursorPos warp emulation (kombucha).
+ *
+ * Apps that keep the cursor visible while dragging with a button held
+ * (e.g. Roblox Studio's editor viewport camera orbit) cannot use the
+ * relative-motion path below, which wayland_pointer_update_constraint()
+ * only enables while the cursor is hidden. They instead poll
+ * GetCursorPos once per frame and call SetCursorPos to recenter,
+ * expecting the round trip to be effectively instant, as it is on
+ * native Win32. Under Wayland a real warp is an async request to the
+ * compositor, so at uneven or low frame rates real mouse motion keeps
+ * accumulating in the background while the app is still waiting for
+ * GetCursorPos to reflect a warp that hasn't landed yet, which is felt
+ * as laggy or jumpy camera movement that gets worse the slower/more
+ * uneven frames are.
+ *
+ * When enabled (opt-in only, see emulate_warp_enabled() below) and a
+ * pointer confinement is active for the focused window,
+ * WAYLAND_SetCursorPos() stops asking the compositor to actually warp
+ * the cursor and instead just remembers the position the app asked
+ * for; WAYLAND_GetCursorPos() reports that remembered position, and
+ * pointer_handle_motion() below keeps it up to date using the real
+ * deltas reported by the compositor, same as the relative-motion path
+ * does, but without requiring the cursor to be hidden. This decouples
+ * cursor sampling from compositor/frame timing entirely. The emulated
+ * position is dropped (falling back to the normal, unmodified
+ * behaviour) as soon as the confinement ends or goes a while without a
+ * fresh SetCursorPos call.
+ */
+
+static BOOL emulate_warp_enabled(void)
+{
+    static int cached = -1;
+    if (cached < 0)
+    {
+        const char *value = getenv("WINE_WAYLAND_EMULATE_MOUSE_WARP");
+        cached = value && strcmp(value, "0") != 0;
+    }
+    return cached;
+}
+
+/* How long an emulated position stays trusted without a fresh
+ * SetCursorPos refreshing it, before we go back to trusting whatever
+ * the compositor itself is reporting. Generous enough to survive a
+ * very slow frame, short enough to recover quickly once the app stops
+ * calling SetCursorPos (e.g. the drag ended). */
+#define WARP_EMUL_TIMEOUT_MS 350
+
+static BOOL warp_emul_live(struct wayland_pointer *pointer, ULONG now)
+{
+    return pointer->warp_active && (now - pointer->last_warp_ms) < WARP_EMUL_TIMEOUT_MS;
+}
+
+/* Drop any emulated position and let Win32 know, via a normal absolute
+ * motion event carrying the last real position the compositor told us
+ * about, so the cursor doesn't stay stuck wherever the emulation left
+ * it once emulation stops applying. */
+static void resync_logical_from_compositor(struct wayland_pointer *pointer)
+{
+    double sx, sy;
+    BOOL valid;
+
+    pthread_mutex_lock(&pointer->mutex);
+    pointer->warp_active = FALSE;
+    pointer->logical_valid = FALSE;
+    valid = pointer->compositor_valid;
+    sx = pointer->compositor_sx;
+    sy = pointer->compositor_sy;
+    pthread_mutex_unlock(&pointer->mutex);
+
+    if (valid) pointer_handle_motion_internal(wl_fixed_from_double(sx), wl_fixed_from_double(sy));
+}
+
 struct system_cursors
 {
     WORD id;
@@ -169,11 +249,61 @@ static void pointer_handle_motion(void *data, struct wl_pointer *wl_pointer,
                                   uint32_t time, wl_fixed_t sx, wl_fixed_t sy)
 {
     struct wayland_pointer *pointer = &process_wayland.pointer;
+    double x, y, dx, dy;
+    BOOL emulate;
+    HWND hwnd;
 
     /* Ignore absolute motion events if in relative mode. */
     if (pointer->relative_mode) return;
 
-    pointer_handle_motion_internal(sx, sy);
+    x = wl_fixed_to_double(sx);
+    y = wl_fixed_to_double(sy);
+
+    pthread_mutex_lock(&pointer->mutex);
+    emulate = emulate_warp_enabled() && pointer->logical_valid &&
+              warp_emul_live(pointer, NtGetTickCount());
+    dx = pointer->compositor_valid ? x - pointer->compositor_sx : 0;
+    dy = pointer->compositor_valid ? y - pointer->compositor_sy : 0;
+    pointer->compositor_sx = x;
+    pointer->compositor_sy = y;
+    pointer->compositor_valid = TRUE;
+    hwnd = pointer->focused_hwnd;
+    pthread_mutex_unlock(&pointer->mutex);
+
+    if (!emulate)
+    {
+        pointer_handle_motion_internal(sx, sy);
+        return;
+    }
+
+    if (hwnd && (dx != 0 || dy != 0))
+    {
+        struct wayland_win_data *win_data;
+        double wdx = 0, wdy = 0;
+        INPUT input = {0};
+
+        if ((win_data = wayland_win_data_get(hwnd)))
+        {
+            wayland_motion_delta_to_window(win_data->wayland_surface, dx, dy, &wdx, &wdy);
+            wayland_win_data_release(win_data);
+        }
+
+        input.type = INPUT_MOUSE;
+        input.mi.dx = (LONG)round(wdx);
+        input.mi.dy = (LONG)round(wdy);
+        input.mi.dwFlags = MOUSEEVENTF_MOVE;
+
+        if (input.mi.dx || input.mi.dy)
+        {
+            pthread_mutex_lock(&pointer->mutex);
+            pointer->logical_pos.x += input.mi.dx;
+            pointer->logical_pos.y += input.mi.dy;
+            pthread_mutex_unlock(&pointer->mutex);
+
+            TRACE("emulated hwnd=%p delta=%d,%d\n", hwnd, (int)input.mi.dx, (int)input.mi.dy);
+            NtUserSendHardwareInput(hwnd, SEND_HWMSG_RAWINPUT, &input, 0);
+        }
+    }
 }
 
 static void wayland_set_cursor(HWND hwnd, HCURSOR hcursor, BOOL use_hcursor);
@@ -223,6 +353,8 @@ static void pointer_handle_leave(void *data, struct wl_pointer *wl_pointer,
     pthread_mutex_lock(&pointer->mutex);
     pointer->focused_hwnd = NULL;
     pointer->enter_serial = 0;
+    pointer->warp_active = FALSE;
+    pointer->logical_valid = FALSE;
     pthread_mutex_unlock(&pointer->mutex);
 }
 
@@ -983,12 +1115,35 @@ void WAYLAND_SetCursor(HWND hwnd, HCURSOR hcursor)
     wayland_set_cursor(hwnd, hcursor, TRUE);
 }
 
+/***********************************************************************
+ *           WAYLAND_GetCursorPos
+ */
+BOOL WAYLAND_GetCursorPos(POINT *pos)
+{
+    struct wayland_pointer *pointer = &process_wayland.pointer;
+
+    /* Matches nulldrv_GetCursorPos()'s contract: always succeed, and
+     * leave *pos untouched unless we actually have something to offer,
+     * so we don't disturb the normal (already correct) behaviour when
+     * warp emulation isn't applicable. */
+    pthread_mutex_lock(&pointer->mutex);
+    if (emulate_warp_enabled() && pointer->logical_valid &&
+        warp_emul_live(pointer, NtGetTickCount()))
+    {
+        *pos = pointer->logical_pos;
+    }
+    pthread_mutex_unlock(&pointer->mutex);
+
+    return TRUE;
+}
+
 /***********************************************************************
  *           WAYLAND_SetCursorPos
  */
 BOOL WAYLAND_SetCursorPos(INT x, INT y)
 {
     struct wayland_pointer *pointer = &process_wayland.pointer;
+    BOOL emulate;
 
     pthread_mutex_lock(&pointer->mutex);
     if (pointer->relative_mode)
@@ -996,7 +1151,29 @@ BOOL WAYLAND_SetCursorPos(INT x, INT y)
         pthread_mutex_unlock(&pointer->mutex);
         return FALSE;
     }
+
+    emulate = emulate_warp_enabled() && pointer->constraint_hwnd &&
+              pointer->constraint_hwnd == pointer->focused_hwnd;
+
+    if (emulate)
+    {
+        /* See the "SetCursorPos warp emulation" comment near the top of
+         * this file. Skip the real, async compositor warp entirely;
+         * pointer_handle_motion() will keep this position accurate
+         * using the real deltas the compositor reports from here on. */
+        pointer->logical_pos.x = x;
+        pointer->logical_pos.y = y;
+        pointer->logical_valid = TRUE;
+        pointer->warp_active = TRUE;
+        pointer->last_warp_ms = NtGetTickCount();
+        pthread_mutex_unlock(&pointer->mutex);
+
+        TRACE("emulated warp to %d,%d (no compositor round trip)\n", x, y);
+        return TRUE;
+    }
+
     pointer->pending_warp = TRUE;
+    pointer->logical_valid = FALSE;
     pthread_mutex_unlock(&pointer->mutex);
 
     TRACE("warping to %d,%d\n", x, y);
@@ -1081,5 +1258,7 @@ BOOL WAYLAND_ClipCursor(const RECT *clip, BOOL reset)
 
     wl_display_flush(process_wayland.wl_display);
 
+    if (!clip) resync_logical_from_compositor(pointer);
+
     return TRUE;
 }
diff --git a/dlls/winewayland.drv/waylanddrv.h b/dlls/winewayland.drv/waylanddrv.h
index c776675..a38850a 100644
--- a/dlls/winewayland.drv/waylanddrv.h
+++ b/dlls/winewayland.drv/waylanddrv.h
@@ -120,6 +120,21 @@ struct wayland_pointer
     struct wayland_cursor cursor;
     double accum_x;
     double accum_y;
+    /* Last surface-local position reported by wl_pointer.motion/enter,
+     * used to derive deltas for the SetCursorPos warp-emulation path
+     * below (kombucha: emulate-visible-cursor-setcursorpos-warps). */
+    double compositor_sx;
+    double compositor_sy;
+    BOOL compositor_valid;
+    /* Emulated Win32 cursor position while warp emulation is active for
+     * the current constrained hwnd. When valid, WAYLAND_GetCursorPos
+     * reports this instead of the (possibly stale, since we stop
+     * issuing real compositor warps while emulating) shared-memory
+     * cursor position. */
+    POINT logical_pos;
+    BOOL logical_valid;
+    BOOL warp_active;
+    ULONG last_warp_ms;
     pthread_mutex_t mutex;
 };
 
@@ -458,6 +473,7 @@ LRESULT WAYLAND_DesktopWindowProc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp);
 void WAYLAND_DestroyWindow(HWND hwnd);
 BOOL WAYLAND_SetIMECompositionRect(HWND hwnd, RECT rect);
 void WAYLAND_SetCursor(HWND hwnd, HCURSOR hcursor);
+BOOL WAYLAND_GetCursorPos(POINT *pos);
 BOOL WAYLAND_SetCursorPos(INT x, INT y);
 void WAYLAND_SetLayeredWindowAttributes(HWND hwnd, COLORREF key, BYTE alpha, DWORD flags);
 void WAYLAND_SetWindowIcons(HWND hwnd, HICON icon, const ICONINFO *ii, HICON icon_small, const ICONINFO *ii_small);
diff --git a/dlls/winewayland.drv/waylanddrv_main.c b/dlls/winewayland.drv/waylanddrv_main.c
index 275a390..cfc92dc 100644
--- a/dlls/winewayland.drv/waylanddrv_main.c
+++ b/dlls/winewayland.drv/waylanddrv_main.c
@@ -38,6 +38,7 @@ static const struct user_driver_funcs waylanddrv_funcs =
     .pClipCursor = WAYLAND_ClipCursor,
     .pDesktopWindowProc = WAYLAND_DesktopWindowProc,
     .pDestroyWindow = WAYLAND_DestroyWindow,
+    .pGetCursorPos = WAYLAND_GetCursorPos,
     .pSetIMECompositionRect = WAYLAND_SetIMECompositionRect,
     .pKbdLayerDescriptor = WAYLAND_KbdLayerDescriptor,
     .pReleaseKbdTables = WAYLAND_ReleaseKbdTables,
-- 
2.43.0

